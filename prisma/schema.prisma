generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  credentials
  google
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  authProvider  AuthProvider @default(credentials)
  monthlyIncome Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  groups        ExpenseGroup[]
  budgetPeriods BudgetPeriod[]
  expenses      Expense[]
  lendingEntries LendingEntry[]
  insightSnapshots AIInsightRequestSnapshot[]
  monthEndReviews MonthEndReviewSnapshot[]
  goals            Goal[]
  goalContributions GoalContribution[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// NextAuth Credentials + OAuth account linking
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ExpenseGroup {
  id              String   @id @default(uuid())
  userId          String
  name            String
  budgetCap       Decimal  @db.Decimal(12, 2)
  isArchived      Boolean  @default(false)
  color           String   @default("gold")
  icon            String   @default("💰")
  rolloverEnabled Boolean  @default(false)
  // At most one non-archived group per user should have this set (enforced in
  // the service layer, not the DB). Overage from every other group is drawn
  // from this group's balance instead of the user's overall balance going
  // negative unchecked - see lib/budget.ts computeEmergencyFundBalance.
  isEmergencyFund Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  periods  BudgetPeriod[]
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
  @@map("expense_groups")
}

// Preserves each month's cap independently so editing a group's current cap
// doesn't rewrite historical months' budget figures.
model BudgetPeriod {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  month     String // "YYYY-MM"
  budgetCap Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, month])
  @@index([userId, month])
  @@map("budget_periods")
}

model Expense {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  spentAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, groupId, spentAt])
  @@index([userId, spentAt])
  @@map("expenses")
}

model LendingEntry {
  id         String    @id @default(uuid())
  userId     String
  personName String
  amount     Decimal   @db.Decimal(12, 2)
  reason     String?
  date       DateTime
  isSettled  Boolean   @default(false)
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lending_entries")
}

model AIInsightRequestSnapshot {
  id           String   @id @default(uuid())
  userId       String
  month        String // "YYYY-MM"
  requestedAt  DateTime @default(now())
  inputSummary Json
  responseText String   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
  @@map("ai_insight_snapshots")
}

// One cached AI-generated narrative per completed month, generated on-demand
// (no scheduler exists) the first time the user asks for that month's review.
model MonthEndReviewSnapshot {
  id           String   @id @default(uuid())
  userId       String
  month        String // "YYYY-MM", always a completed month
  generatedAt  DateTime @default(now())
  inputSummary Json
  responseText String   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("month_end_reviews")
}

// A savings "pot" - money set aside toward a goal. Saved amount is earmarked
// and excluded from unallocated income; it cannot be assigned to a group or
// spent directly, and carries forward across months until the goal completes.
model Goal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  icon         String    @default("🎯")
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@unique([userId, name])
  @@index([userId])
  @@map("goals")
}

// Signed ledger entry for a goal: positive = contribution, negative = withdrawal.
model GoalContribution {
  id        String   @id @default(uuid())
  userId    String
  goalId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, goalId])
  @@map("goal_contributions")
}